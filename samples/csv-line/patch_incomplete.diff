--- a/src/csv.mjs
+++ b/src/csv.mjs
@@ -1,3 +1,12 @@
-export function splitCSVLine(line) {
-  return line.split(',');
-}
+export function splitCSVLine(line) {
+  const fields = [];
+  let field = '';
+  let quoted = false;
+  for (const char of line) {
+    if (char === '"') quoted = !quoted;
+    else if (char === ',' && !quoted) { fields.push(field); field = ''; }
+    else field += char;
+  }
+  fields.push(field);
+  return fields;
+}
